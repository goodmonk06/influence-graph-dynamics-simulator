{
  "name": "influence-graph-dynamics-simulator",
  "version": "1.0.0",
  "description": "An influence dynamics simulator for modeling message propagation in social networks",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "cd packages/backend && pnpm prisma generate",
    "db:migrate": "cd packages/backend && pnpm prisma migrate dev",
    "db:seed": "cd packages/backend && pnpm prisma db seed",
    "db:studio": "cd packages/backend && pnpm prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
